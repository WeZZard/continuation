def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agentic-continuation", description=__doc__)
    parser.add_argument("--actor", default="human",
                        help="Who is invoking (human | agent-plugin | dispatcher).")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("register", help="Register a task with its continuation.")
    p.add_argument("task_id")
    p.add_argument("--agent", choices=("claude-code", "pi"), required=True)
    p.add_argument("--continuation", required=True,
                   help="Continuation core JSON file, or - for stdin.")
    p.add_argument("--single-run", action="store_true")
    p.add_argument("--must-not", action="append",
                   help="Task-scoped MUST NOT rule (repeatable), without the prefix.")
    p.add_argument("--allow-write", action="append")
    p.add_argument("--allow-net", action="append")
    p.add_argument("--agent-command", default=None,
                   help="Override the agent binary (testing / custom installs).")
    p.add_argument("--force", action="store_true")
    p.set_defaults(fn=cmd_register)

    p = sub.add_parser("unregister", help="Remove a task from the registry.")
    p.add_argument("task_id")
    p.set_defaults(fn=cmd_unregister)

    p = sub.add_parser("list", help="Tasks, runs, continuations, due-state.")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("show", help="Render a continuation document.")
    p.add_argument("task_id")
    p.add_argument("--run")
    p.add_argument("--continuation")
    p.set_defaults(fn=cmd_show)

    p = sub.add_parser("continue", help="Register an agent's returned continuations (stdin: final message).")
    p.add_argument("task_id")
    p.add_argument("--run", required=True)
    p.add_argument("--from", dest="from_id", required=True)
    p.add_argument("--session-ref", default="")
    p.set_defaults(fn=cmd_continue)

    p = sub.add_parser("tick", help="Evaluate every due continuation.")
    p.add_argument("--task")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_tick)

    p = sub.add_parser("queue", help="THE queue: open entries in activation order.")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_queue)

    p = sub.add_parser("log", help="Read the events log.")
    p.add_argument("--task")
    p.add_argument("--run")
    p.add_argument("-n", dest="limit", type=int, default=0)
    p.set_defaults(fn=cmd_log)

    p = sub.add_parser("verify", help="Check artifact paths claimed in contexts.")
    p.add_argument("task_id")
    p.set_defaults(fn=cmd_verify)

    p = sub.add_parser("migrate", help="Import a pre-SQLite file store into the queue.")
    p.set_defaults(fn=cmd_migrate)

    p = sub.add_parser("serve", help="Node API: read-only HTTP + SSE over the store.")
    p.add_argument("--port", type=int, default=DEFAULT_SERVE_PORT,
                   help=f"Listen port (default {DEFAULT_SERVE_PORT}; 0 = ephemeral).")
    p.add_argument("--bind", default="0.0.0.0")
    p.add_argument("--no-mdns", action="store_true",
                   help="Do not advertise via Bonjour (dns-sd).")
    p.add_argument("--sse-poll", type=float, default=1.5,
                   help="Seconds between event-table polls per SSE stream.")
    p.set_defaults(fn=cmd_serve)

    p = sub.add_parser("install-launchd", help="Install + load the tick schedule.")
    p.set_defaults(fn=cmd_install_launchd)
    p = sub.add_parser("uninstall-launchd", help="Unload + remove the tick schedule.")
    p.set_defaults(fn=cmd_uninstall_launchd)
    p = sub.add_parser("install-serve-launchd",
                       help="Install + load the node API server (KeepAlive).")
    p.set_defaults(fn=cmd_install_serve_launchd)
    p = sub.add_parser("uninstall-serve-launchd",
                       help="Unload + remove the node API server.")
    p.set_defaults(fn=cmd_uninstall_serve_launchd)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.cmd != "migrate" and (STORE / "registry.json").exists():
        raise SystemExit(
            f"legacy file store detected at {STORE} — run"
            " `agentic-continuation migrate` first")
    try:
        return args.fn(args)
    except SystemExit:
        raise
    except Exception as error:  # noqa: BLE001 — audit trail before dying
        try:
            conn = db()
            event(conn, getattr(args, "cmd", "?"), args.actor,
                  outcome="error", error=f"{type(error).__name__}: {error}")
        except Exception:  # noqa: BLE001 — never mask the original failure
            pass
        raise


if __name__ == "__main__":
    sys.exit(main())
